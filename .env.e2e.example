# This file is a local bot transport E2E template. Copy it to .env.e2e.
E2E_TEST_MODE=true
# По умолчанию true; false оставляет ответственность за schema на разработчике.
E2E_RUN_MIGRATIONS=true
# Recovery непрочитанных VK ЛС проверяется отдельным service-spec, а не в
# сценариях polling. Это исключает фоновый запрос при закрытии fake API.
E2E_SKIP_VK_UNREAD_RECOVERY=true
NODE_ENV=testing

# The runner accepts only a database whose name ends with -e2e or _e2e.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DATABASE=ystuty-schedule-bot-dev-e2e
POSTGRES_USER=utest
POSTGRES_PASSWORD=replace-me
POSTGRES_SYNCHRONIZE=false

# Keep E2E keys isolated even when Redis DB 5 is shared by local services.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DATABASE=5
REDIS_PREFIX=ystuty.schedule.bot:e2e:

# Fake servers replace these values at runtime with their local HTTP addresses.
SCHEDULE_API_URL=http://127.0.0.1:0
SOCIAL_TELEGRAM_BOT_TOKEN=900001:AAE2eFakeTelegramTokenForLocalTests000000
SOCIAL_TELEGRAM_BOT_NAME=ystuty_schedule_e2e_bot
SOCIAL_TELEGRAM_ADMIN_IDS=[]
SOCIAL_TELEGRAM_API_ROOT=http://127.0.0.1:0
SOCIAL_VK_GROUP_ID=900001
SOCIAL_VK_GROUP_TOKEN=e2e-vk-group-token
SOCIAL_VK_ADMIN_IDS=[]
SOCIAL_VK_API_BASE_URL=http://127.0.0.1:0/method

# External integration and optional background side effects are intentionally disabled.
SOCAIL_CONNECT_URI=
PROMETHEUS_ENABLED=false
PROMETHEUS_SCHEDULE_AVAILABILITY_METRICS=false
