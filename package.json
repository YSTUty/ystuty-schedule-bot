{
  "name": "ystuty-schedule-bot",
  "version": "0.4.0",
  "description": "",
  "author": "xTCry [Vladislav Kh] (https://github.com/xTCry/)",
  "private": true,
  "license": "MIT",
  "repository": {
    "url": "https://github.com/YSTUty/ystuty-schedule-bot.git",
    "type": "git"
  },
  "homepage": "https://github.com/YSTUty/ystuty-schedule-bot#readme",
  "bugs": {
    "url": "https://github.com/YSTUty/ystuty-schedule-bot/issues"
  },
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "start:prod_orm": "npm run typeorm:run:prod && npm run start:prod",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "lint:fix": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "node --experimental-vm-modules ./node_modules/.bin/jest",
    "test:watch": "node --experimental-vm-modules ./node_modules/.bin/jest --watch",
    "test:cov": "node --experimental-vm-modules ./node_modules/.bin/jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "typeorm": "node -r tsconfig-paths/register ./node_modules/typeorm/cli-ts-node-commonjs.js -d ./src/data-source.ts",
    "typeorm:prod": "node ./node_modules/typeorm/cli.js -d ./dist/data-source.js",
    "typeorm:cache": "npm run typeorm cache:clear",
    "typeorm:create": "typeorm migration:create ./src/migrations/schema-update",
    "typeorm:migrate": "npm run typeorm migration:generate ./src/migrations/schema-update",
    "typeorm:show": "npm run typeorm migration:show",
    "typeorm:run": "npm run typeorm migration:run",
    "typeorm:run:prod": "npm run typeorm:prod migration:run",
    "typeorm:revert": "npm run typeorm migration:revert",
    "prepare": "husky",
    "release": "release-it",
    "release:major": "release-it major",
    "release:minor": "release-it minor",
    "release:patch": "release-it patch"
  },
  "dependencies": {
    "@esindger/telegraf-i18n": "^0.5.5",
    "@khaledez/nestjs-prom": "^1.0.0",
    "@nestjs/axios": "^4.0.1",
    "@nestjs/bull": "^11.0.4",
    "@nestjs/common": "^11.1.19",
    "@nestjs/core": "^11.1.19",
    "@nestjs/platform-express": "^11.1.19",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/typeorm": "^11.0.3",
    "@vk-io/hear": "^1.1.1",
    "@vk-io/scenes": "^1.2.1",
    "@vk-io/session": "^2.2.1",
    "@xtcry/nestjs-telegraf": "^2.7.1",
    "async-mutex": "0.5.0",
    "axios": "^0.27",
    "bull": "^4.16.5",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "dotenv": "^16.0.1",
    "dotenv-expand": "^10.0.0",
    "ioredis": "5.8.2",
    "moment": "^2.29.4",
    "nestjs-vk": "^4.8.0",
    "oauth": "^0.10.0",
    "p-queue": "7.4.1",
    "pg": "^8.23.0",
    "prom-client": "^15.1.3",
    "redlock": "^4.2.0",
    "redlock-universal": "0.6.0",
    "reflect-metadata": "^0.1.13",
    "rimraf": "^3.0.2",
    "rxjs": "^7.8.2",
    "telegraf": "^4.16.3",
    "telegraf-session-redis": "^5.1.0",
    "typeorm": "0.3.20",
    "vk-io": "^4.10.1",
    "vk-io-i18n": "^0.0.1",
    "vk-io-redis-storage": "^1.1.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^17.7.0",
    "@commitlint/config-conventional": "^17.7.0",
    "@nestjs/cli": "^11.0.21",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.1.19",
    "@release-it/conventional-changelog": "^12.0.0",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/dotenv": "^8.2.0",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/node": "22.0.0",
    "@types/oauth": "^0.9.1",
    "@types/redlock": "^4.0.3",
    "@types/supertest": "^2.0.16",
    "@typescript-eslint/eslint-plugin": "^8.59.0",
    "@typescript-eslint/parser": "^8.59.0",
    "eslint": "^8.48.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "husky": "^9.0.11",
    "jest": "^29.7.0",
    "prettier": "^3.7.4",
    "release-it": "^21.0.2",
    "supertest": "^6.3.4",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.4.4",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3"
  },
  "resolutions": {
    "@khaledez/nestjs-prom/prom-client": "15.1.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@my-environment$": "<rootDir>/environment",
      "^@my-common$": "<rootDir>/common",
      "^@my-common/(.*)$": "<rootDir>/common/$1",
      "^@my-interfaces$": "<rootDir>/interface",
      "^@my-interfaces/(.*)$": "<rootDir>/interface/$1"
    }
  }
}
